# Required to start the server and persist application data.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Application defaults (optional).
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
COOKIE_NAME=mystery_session

# Required to generate mysteries. Keep both values on the server only.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=1

# Media defaults use mock images and simulated, unavailable video.
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_MODEL=gemini-nano-banana-2.1
IMAGE_RESOLUTION=1K
VIDEO_PROVIDER=simulation
VIDEO_API_KEY=
VIDEO_MODEL=gemini-omni-1.1-flash
VIDEO_RESOLUTION=720p
VIDEO_MAX_DURATION_SECONDS=8

# Local media storage and resource limits (optional defaults).
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=./storage/media
MEDIA_MAX_RETRIES=2
MEDIA_PROVIDER_TIMEOUT_MS=600000
MEDIA_MAX_ASSET_BYTES=52428800
MEDIA_MAX_IMAGES_PER_MYSTERY=3
MEDIA_VALIDATE_IMAGES=true
